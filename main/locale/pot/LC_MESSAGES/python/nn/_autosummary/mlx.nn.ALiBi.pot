#: ../../../../../../.conda/lib/python3.12/site-packages/mlx/nn/layers/positional_encoding.py:docstring
#: of mlx.nn.layers.positional_encoding.ALiBi:3
msgid ""
"ALiBi adds a static, non-learnable bias matrix to attention scores "
"proportional to the distance between query and key tokens."
msgstr ""

#: ../../../../../../.conda/lib/python3.12/site-packages/mlx/nn/layers/positional_encoding.py:docstring
#: of mlx.nn.layers.positional_encoding.ALiBi:6
msgid ""
"For more details see `Train Short, Test Long: Attention with Linear Biases "
"Enables Input Length Extrapolation <https://arxiv.org/abs/2108.12409>`_."
msgstr ""

