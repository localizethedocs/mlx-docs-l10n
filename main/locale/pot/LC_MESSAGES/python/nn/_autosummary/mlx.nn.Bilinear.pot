msgid "mlx.nn.Bilinear"
msgstr ""

#: ../../../../../../.conda/lib/python3.12/site-packages/mlx/nn/layers/linear.py:docstring
#: of mlx.nn.layers.linear.Bilinear:1
msgid "Applies a bilinear transformation to the inputs."
msgstr ""

#: ../../../../../../.conda/lib/python3.12/site-packages/mlx/nn/layers/linear.py:docstring
#: of mlx.nn.layers.linear.Bilinear:3
msgid "Concretely:"
msgstr ""

#: ../../../../../../.conda/lib/python3.12/site-packages/mlx/nn/layers/linear.py:docstring
#: of mlx.nn.layers.linear.Bilinear:5
msgid "y_i = x_1^\\top W_i x_2 + b_i"
msgstr ""

#: ../../../../../../.conda/lib/python3.12/site-packages/mlx/nn/layers/linear.py:docstring
#: of mlx.nn.layers.linear.Bilinear:9
msgid ""
"where: :math:`W` has shape ``[output_dims, input1_dims, input2_dims]``, :"
"math:`b` has shape ``[output_dims ]``, and :math:`i` indexes the output "
"dimension."
msgstr ""

#: ../../../../../../.conda/lib/python3.12/site-packages/mlx/nn/layers/linear.py:docstring
#: of mlx.nn.layers.linear.Bilinear:13
msgid ""
"The values are initialized from the uniform distribution :math:`\\mathcal{U}"
"(-{k}, {k})`, where :math:`k = \\frac{1}{\\sqrt{D_1}}` and :math:`D_1` is "
"``input1_dims``."
msgstr ""

