#: ../../../docstring of mlx.core.blackman:1
msgid "Return the Blackman window."
msgstr ""

#: ../../../docstring of mlx.core.blackman:3
msgid ""
"The Blackman window is a taper formed by using the first three terms of a "
"summation of cosines."
msgstr ""

#: ../../../docstring of mlx.core.blackman:5
msgid ""
"w(n) = 0.42 - 0.5 \\cos\\left(\\frac{2\\pi n}{M-1}\\right) + 0.08 "
"\\cos\\left(\\frac{4\\pi n}{M-1}\\right)\n"
" \\qquad 0 \\le n \\le M-1\n"
"\n"
msgstr ""

