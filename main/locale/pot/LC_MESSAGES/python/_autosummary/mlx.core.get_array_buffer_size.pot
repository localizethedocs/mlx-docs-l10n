#: ../../../src/python/_autosummary/mlx.core.get_array_buffer_size.rst:2
msgid "mlx.core.get\\_array\\_buffer\\_size"
msgstr ""

#: ../../../docstring of mlx.core.get_array_buffer_size:1
msgid "Get the size of the buffers backing arrays in bytes."
msgstr ""

#: ../../../docstring of mlx.core.get_array_buffer_size:3
msgid ""
"Each unique buffer is counted once. The full allocator size of each buffer "
"is used, which can exceed the logical size of its arrays. Arrays must be "
"evaluated before calling this function. The result does not include graph "
"objects, cached buffers, or other non-buffer memory."
msgstr ""

#: ../../../src/python/_autosummary/mlx.core.get_array_buffer_size.rst:0
msgid "Parameters"
msgstr ""

#: ../../../docstring of mlx.core.get_array_buffer_size:8
msgid ""
"Each argument can be a single array or a tree of arrays. Leaves which are "
"not arrays are ignored."
msgstr ""

#: ../../../src/python/_autosummary/mlx.core.get_array_buffer_size.rst:0
msgid "Returns"
msgstr ""

#: ../../../docstring of mlx.core.get_array_buffer_size:12
msgid "The size of the unique buffers in bytes."
msgstr ""

