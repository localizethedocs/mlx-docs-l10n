#: ../../../src/python/_autosummary/mlx.core.distributed.sum_scatter.rst:2
msgid "mlx.core.distributed.sum\\_scatter"
msgstr ""

#: ../../../docstring of mlx.core.distributed.sum_scatter:1
msgid ""
"Sum ``x`` across all processes in the group and shard the result along the "
"first axis across ranks. ``x.shape[0]`` must be divisible by the group size."
msgstr ""

#: ../../../docstring of mlx.core.distributed.sum_scatter:4
msgid ""
"The result is equivalent to ``all_sum(x)[rank*chunk_size:"
"(rank+1)*chunk_size]``, where ``chunk_size = x.shape[0] // group.size()`` "
"and ``rank`` is the rank of this process in the group. Note: ``all_sum`` is "
"mentioned only for illustration; the actual implementation does not perform "
"``all_sum`` and uses a single reduce-scatter collective instead. Currently "
"supported only for the NCCL backend."
msgstr ""

#: ../../../src/python/_autosummary/mlx.core.distributed.sum_scatter.rst:0
msgid "Parameters"
msgstr ""

#: ../../../docstring of mlx.core.distributed.sum_scatter:8
msgid "Input array."
msgstr ""

#: ../../../docstring of mlx.core.distributed.sum_scatter:10
msgid ""
"The group of processes that will participate in the sum scatter. If set to "
"``None`` the global group is used. Default: ``None``."
msgstr ""

#: ../../../docstring of mlx.core.distributed.sum_scatter:14
msgid ""
"Stream or device. Defaults to ``None`` in which case the default stream of "
"the default device is used."
msgstr ""

#: ../../../src/python/_autosummary/mlx.core.distributed.sum_scatter.rst:0
msgid "Returns"
msgstr ""

#: ../../../docstring of mlx.core.distributed.sum_scatter:18
msgid ""
"The output array with shape ``[x.shape[0] // group.size(), *x.shape[1:]]``."
msgstr ""

#: ../../../src/python/_autosummary/mlx.core.distributed.sum_scatter.rst:0
msgid "Return type"
msgstr ""
