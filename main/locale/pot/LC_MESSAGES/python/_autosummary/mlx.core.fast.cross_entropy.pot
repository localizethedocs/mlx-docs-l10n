#: ../../../src/python/_autosummary/mlx.core.fast.cross_entropy.rst:2
msgid "mlx.core.fast.cross\\_entropy"
msgstr ""

#: ../../../docstring of mlx.core.fast.cross_entropy:1
msgid "Cross entropy loss with class indices as targets."
msgstr ""

#: ../../../docstring of mlx.core.fast.cross_entropy:3
msgid ""
"Computes ``logsumexp(logits, axis=-1) - logits[..., target]`` in a fused "
"kernel with accumulation in float32."
msgstr ""

#: ../../../docstring of mlx.core.fast.cross_entropy:6
msgid ""
"Note: Currently is implemented only on CUDA, fallback to unfused version "
"with manual casting on Metal and CPU."
msgstr ""

#: ../../../src/python/_autosummary/mlx.core.fast.cross_entropy.rst:0
msgid "Parameters"
msgstr ""

#: ../../../docstring of mlx.core.fast.cross_entropy:9
msgid "The unnormalized logits. The loss is computed over the last axis."
msgstr ""

#: ../../../docstring of mlx.core.fast.cross_entropy:12
msgid ""
"Class indices. The shape should match the shape of ``logits`` with the last "
"axis removed. The indices must be in ``[0, logits.shape[-1])``."
msgstr ""

#: ../../../src/python/_autosummary/mlx.core.fast.cross_entropy.rst:0
msgid "Returns"
msgstr ""

#: ../../../docstring of mlx.core.fast.cross_entropy:17
msgid "The per-element loss in float32, with the shape of ``targets``."
msgstr ""

