#: ../../../src/python/_autosummary/mlx.core.searchsorted.rst:2
msgid "mlx.core.searchsorted"
msgstr ""

#: ../../../docstring of mlx.core.searchsorted:1
msgid ""
"Find the indices that keep ``sorted_sequence`` sorted when inserting "
"``values``."
msgstr ""

#: ../../../docstring of mlx.core.searchsorted:0
msgid "Parameters"
msgstr ""

#: ../../../docstring of mlx.core.searchsorted:3
msgid "A 1-D array sorted in ascending order."
msgstr ""

#: ../../../docstring of mlx.core.searchsorted:5
msgid "The values to insert. May have any shape."
msgstr ""

#: ../../../docstring of mlx.core.searchsorted:7
msgid ""
"Either ``'left'`` or ``'right'``. With ``'left'`` the first suitable index "
"is returned, so the result is the number of elements strictly less than the "
"value. With ``'right'`` the last is returned, so the result is the number of "
"elements less than or equal to it. The two differ only where a value is "
"already present. Default: ``'left'``."
msgstr ""

#: ../../../docstring of mlx.core.searchsorted:0
msgid "Returns"
msgstr ""

#: ../../../docstring of mlx.core.searchsorted:15
msgid ""
"A ``uint32`` array with the same shape as ``values``, holding indices in "
"``[0, sorted_sequence.size]``."
msgstr ""

#: ../../../docstring of mlx.core.searchsorted:0
msgid "Return type"
msgstr ""

