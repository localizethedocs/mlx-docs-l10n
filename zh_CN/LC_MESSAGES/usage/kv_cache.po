#: ../../../src/usage/kv_cache.rst:4
msgid "Writing a Fast KV Cache"
msgstr ""

#: ../../../src/usage/kv_cache.rst:6
msgid ""
"Autoregressive generation appends one position to the key and value arrays "
"for each generated token. The append strategy can dominate KV-cache "
"performance."
msgstr ""

#: ../../../src/usage/kv_cache.rst:9
msgid "Avoid appending naively with :func:`concatenate`:"
msgstr ""

#: ../../../src/usage/kv_cache.rst:11
msgid ""
"# Avoid this\n"
"cache = mx.zeros((1, 0, d))\n"
"for x in steps:\n"
"    cache = mx.concatenate([cache, x], axis=1)\n"
"    mx.eval(cache)"
msgstr ""

#: ../../../src/usage/kv_cache.rst:19
msgid "Instead, preallocate fixed-size chunks and update the cache in place:"
msgstr ""

#: ../../../src/usage/kv_cache.rst:21
msgid ""
"chunk = 256\n"
"cache = mx.zeros((1, chunk, d))\n"
"offset = 0\n"
"for x in steps:\n"
"    if offset == cache.shape[1]:\n"
"        cache = mx.concatenate([cache, mx.zeros((1, chunk, d))], axis=1)\n"
"    cache = mx.slice_update(cache, x, mx.array(offset), (1,))\n"
"    offset += 1\n"
"    mx.eval(cache)\n"
"\n"
"keys = cache[:, :offset]"
msgstr ""

#: ../../../src/usage/kv_cache.rst:35
msgid ""
"You can also use indexed assignment, which may read more naturally: "
"``cache[:, offset : offset + 1, :] = x``."
msgstr ""

