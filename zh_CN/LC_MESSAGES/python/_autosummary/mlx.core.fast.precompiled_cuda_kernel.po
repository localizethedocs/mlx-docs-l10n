msgid ""
"The dynamic shared memory to request for the kernel. A value of 0 means no "
"dynamic shared memory. Default: ``0``."
msgstr ""

#: ../../../docstring of mlx.core.fast.precompiled_cuda_kernel:26
msgid ""
"Optional value to use to initialize all of the output arrays. By default, "
"output arrays are uninitialized. Default: ``None``."
msgstr ""

#: ../../../docstring of mlx.core.fast.precompiled_cuda_kernel:29
msgid ""
"Whether to ensure the inputs are row contiguous before the kernel runs. "
"Default: ``False``."
msgstr ""

#: ../../../docstring of mlx.core.fast.precompiled_cuda_kernel:32
msgid "Stream to run the kernel on. Default: ``None``."
msgstr ""
