msgid ""
"3-tuple specifying the grid to launch the kernel with. For compatibility "
"with :func:`metal_kernel` the grid is in threads and not in threadblocks."
msgstr ""

#: ../../../docstring of mlx.core.fast.precompiled_cuda_kernel:21
msgid "3-tuple specifying the threadgroup size to use."
msgstr ""

